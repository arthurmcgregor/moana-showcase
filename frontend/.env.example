# Copy to .env.local (gitignored) — or let `mise run dev:setup` write it for you.
#
# Both base URLs already default to these values in src/config.ts, so the only entry
# that has to be filled in is the Mapbox token; without it the map renders blank.

# ESP32 boat unit
VITE_DEVICE_SERVER_BASE_URL=http://moana.local

# Django API
VITE_WEB_SERVER_BASE_URL=http://localhost:8000

# Mapbox access token — required for the map
VITE_MAPBOX_ACCESS_TOKEN=
