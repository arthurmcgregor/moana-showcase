# Django
# Generate a secret key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Shared secret proving a request came through the reverse proxy: Remote-User is
# ignored without it, so nobody reaching Django directly can claim to be staff.
# settings_prod requires this — no default — and it must match the value the proxy
# sends as X-Proxy-Auth. Generate with: openssl rand -hex 32
REMOTE_USER_PROXY_SECRET=change-me

# PostgreSQL (used by both the db service and Django)
POSTGRES_DB=moana
POSTGRES_USER=moana_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS / CSRF (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# Host port mapping
WEB_PORT=8000

# Immich integration (leave blank to disable; endpoints return empty photo list)
IMMICH_URL=
IMMICH_API_KEY=
IMMICH_PUBLIC_URL=
