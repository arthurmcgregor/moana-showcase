# Production settings for the root docker-compose.yml. Placeholder values:
# secrets go in secret.env (see example-secret.env), never here.

DJANGO_ALLOWED_HOSTS=moana.example.com
CORS_ALLOWED_ORIGINS=https://moana.example.com
CSRF_TRUSTED_ORIGINS=https://moana.example.com

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# Loopback only: everything reaches these through the reverse proxy.
WEB_PORT=127.0.0.1:8000
DB_PORT=127.0.0.1:5432

POSTGRES_DB=moana
POSTGRES_USER=moana
POSTGRES_HOST=db
POSTGRES_PORT=5432

VITE_DEVICE_SERVER_BASE_URL=/api/tracks/device
VITE_WEB_SERVER_BASE_URL=https://moana.example.com
FRONTEND_PORT=127.0.0.1:8069

# The boat unit's LAN address, which Django proxies device calls to.
DEVICE_URL=http://192.168.1.50

IMMICH_URL=
IMMICH_PUBLIC_URL=
